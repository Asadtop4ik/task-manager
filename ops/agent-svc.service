[Unit]
Description=Task Manager local Codex agent service (agent-svc)
After=network-online.target
Wants=network-online.target
# One-time install steps, users, paths and rollback: docs/AGENT_SVC.md.
# Installed by ops/install_agent_svc.sh; do not hand-edit on the server.

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=90
User=agent-svc
Group=agent-svc
SupplementaryGroups=agentwork
WorkingDirectory=/opt/agent-svc
Environment=PYTHONPATH=/opt/agent-svc
ExecStart=/usr/bin/python3 -m agent_svc run
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=60

# Non-secret config: /etc/agent-svc/config.json (ops/install_agent_svc.sh installs the
# default from agentsvc/config.example.json only if it does not already exist).
StateDirectory=agent-svc
StateDirectoryMode=0750
RuntimeDirectory=agent-svc

# Secrets are never read from the environment. systemd exposes each of these under
# $CREDENTIALS_DIRECTORY/<name>; agent_svc/config.py reads them from there.
LoadCredential=agent_svc_token:/etc/agent-svc/credentials/agent_svc_token
LoadCredential=callback_token:/etc/agent-svc/credentials/callback_token
LoadCredential=intake_worker_token:/etc/agent-svc/credentials/intake_worker_token
LoadCredential=github_agent_token:/etc/agent-svc/credentials/github_agent_token
LoadCredential=github_public_agent_token:/etc/agent-svc/credentials/github_public_agent_token
LoadCredential=github_qa_token:/etc/agent-svc/credentials/github_qa_token

# Codex children run for minutes at a time under bubblewrap; they are spawned via the
# `sudo -n -u codex-runner` rule in /etc/sudoers.d/60-agent-svc and stay in this unit's
# control group (KillMode=control-group above reaches them too), so these limits cover
# agent-svc itself plus every Codex child it currently has running.
CPUQuota=200%
MemoryMax=3G

# Hardening modeled on ops/task-manager-intake.service (same sudo-to-codex-runner shape).
# NoNewPrivileges=no: the sudo(8) rule below requires the setuid bit to take effect.
NoNewPrivileges=no
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/agent-svc /srv/agent-svc /home/codex-runner/.codex-code /home/codex-runner/.codex-chat /run/agent-svc
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ProtectProc=invisible
# Codex's bubblewrap namespace setup reads /proc/sys/kernel/overflowuid, same as intake.
ProcSubset=all
UMask=0027

# agent-svc must never be able to read Task Manager's own secrets, config or the
# deploy account's home, even though ProtectHome=read-only would otherwise allow a read.
# docker.sock is intentionally left reachable: the root-only image_state.py helper
# (invoked via sudo) needs it, and codex-runner is not in the docker group either way.
InaccessiblePaths=/srv/stack/env /etc/task-manager /home/deploy

[Install]
WantedBy=multi-user.target
