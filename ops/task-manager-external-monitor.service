[Unit]
Description=Verify external Codex PR merges and production deploys
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
SupplementaryGroups=docker
EnvironmentFile=/etc/task-manager/external-monitor.env
ExecStart=/usr/bin/python3 /opt/task-manager/ops/agent_deploy_monitor.py
TimeoutStartSec=180s
CPUQuota=20%
MemoryMax=128M
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
