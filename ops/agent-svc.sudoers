# agent-svc sudo rules: two exact, argv-pinned commands, nothing else.
# Defaults env_reset (the system default, not overridden here) strips the calling
# environment before exec, so agent-svc cannot inject secrets or PATH tricks into
# either target command via the environment.
Defaults:agent-svc !requiretty

# Run the sandboxed Codex child as the dedicated agent-codex account — NOT
# codex-runner, which is the live GitHub Actions self-hosted runner and must never
# share a uid with anything Codex's sandbox can reach (runner credentials, checkout
# tokens, its own Codex auth). Only these five subcommands are allowed, each pinned
# with `-I` (isolated mode: ignores PYTHONPATH/PYTHONSTARTUP/user site-packages, so
# agent-svc's own environment can't smuggle an import override into the child);
# codex_child.py itself validates every argument it receives on stdin (run_id, lane,
# model, effort, sandbox, paths). `preflight` runs the trusted formatter/lint step
# (ruff/black/compileall) as agent-codex, never as agent-svc: those tools execute
# inside a directory whose content is entirely attacker-controlled (the agent's own
# patch), so running them as agent-svc would let a malicious patch read every
# credential agent-svc can reach (security round 2, blocker 1). The paths below are
# the stable, root-owned symlinks into the active release (see
# ops/install_agent_svc.sh); the sudoers rule is pinned to these stable paths, never
# to a release-specific one. There is no `--version` entry: agent_svc's self-check
# verifies this rule is reachable with `sudo -n -l`, which does not require running
# the target command at all. `discussion` (Phase 3, chat lane): one read-only
# `/suhbat` app-server turn, same trust boundary as the other five.
agent-svc ALL=(agent-codex) NOPASSWD: /usr/bin/python3 -I /opt/agent-svc/libexec/codex_child.py prepare, /usr/bin/python3 -I /opt/agent-svc/libexec/codex_child.py exec, /usr/bin/python3 -I /opt/agent-svc/libexec/codex_child.py package, /usr/bin/python3 -I /opt/agent-svc/libexec/codex_child.py preflight, /usr/bin/python3 -I /opt/agent-svc/libexec/codex_child.py cleanup, /usr/bin/python3 -I /opt/agent-svc/libexec/codex_child.py discussion

# Read-only Docker state for the project catalog's containers. Runs as root because
# neither agent-svc nor agent-codex is in the docker group; image_state.py only
# calls `docker inspect` on catalog-listed container names and prints
# image/running/health JSON. Also pinned with `-I` (see above).
agent-svc ALL=(root) NOPASSWD: /usr/bin/python3 -I /opt/agent-svc/libexec/image_state.py *
