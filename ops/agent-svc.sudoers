# agent-svc sudo rules: two exact, argv-pinned commands, nothing else.
# Defaults env_reset (the system default, not overridden here) strips the calling
# environment before exec, so agent-svc cannot inject secrets or PATH tricks into
# either target command via the environment.
Defaults:agent-svc !requiretty

# Run the sandboxed Codex child as the dedicated agent-codex account — NOT
# codex-runner, which is the legacy GitHub Actions runner account and must never
# share a uid with anything Codex's sandbox can reach (runner credentials, checkout
# tokens, its own Codex auth). Only these five subcommands are allowed, each pinned
# with `-I` (isolated mode: ignores PYTHONPATH/PYTHONSTARTUP/user site-packages, so
# agent-svc's own environment can't smuggle an import override into the child);
# codex_child.py itself validates every argument it receives on stdin (run_id, lane,
# model, effort, sandbox, paths). `preflight` runs the trusted formatter/lint step
# (ruff/black/compileall) as agent-codex, never as agent-svc: those tools execute
# inside a directory whose content is entirely attacker-controlled (the agent's own
# patch), so running them as agent-svc would let a malicious patch read every
# credential agent-svc can reach (security round 2, blocker 1). The paths below are
# the stable, root-owned symlinks into the active release (see
# ops/install_agent_svc.sh); the sudoers rule is pinned to these stable paths, never
# to a release-specific one. There is no `--version` entry: agent_svc's self-check
# verifies this rule is reachable with `sudo -n -l`, which does not require running
# the target command at all.
agent-svc ALL=(agent-codex) NOPASSWD: /usr/bin/python3 -I /opt/agent-svc/libexec/codex_child.py prepare, /usr/bin/python3 -I /opt/agent-svc/libexec/codex_child.py exec, /usr/bin/python3 -I /opt/agent-svc/libexec/codex_child.py package, /usr/bin/python3 -I /opt/agent-svc/libexec/codex_child.py preflight, /usr/bin/python3 -I /opt/agent-svc/libexec/codex_child.py cleanup

# `discussion` (Phase 3, chat lane): one read-only `/suhbat` app-server turn, same
# agent-codex trust boundary as the five above, PLUS the `task-diag-client` group —
# and ONLY that group, and ONLY for this one subcommand — so the app-server can
# reach the owner-only Ketoshop diagnostics socket for the duration of this one
# call. `agent-codex` is never a permanent member of `task-diag-client` (see
# ops/install_agent_svc.sh); this is the sole place it is ever granted, matching
# `CodexRunner.run_discussion`'s own `sudo -n -u agent-codex -g task-diag-client --`.
agent-svc ALL=(agent-codex : task-diag-client) NOPASSWD: /usr/bin/python3 -I /opt/agent-svc/libexec/codex_child.py discussion

# Read-only Docker state for the project catalog's containers. Runs as root because
# neither agent-svc nor agent-codex is in the docker group; image_state.py only
# calls `docker inspect` on catalog-listed container names and prints
# image/running/health JSON. Also pinned with `-I` (see above).
agent-svc ALL=(root) NOPASSWD: /usr/bin/python3 -I /opt/agent-svc/libexec/image_state.py *

# agent "ops requests" (agent-svc-notes/ops-requests-spec.md): starts the static,
# root oneshot unit agent-ops-apply.service, which applies ONE owner-approved
# env-file change and restarts the affected stack. This argv carries no request
# data at all — the whole request is a separate, root-owned file agent-svc wrote
# first (/run/agent-svc/ops/request.json), which env_apply.py independently
# re-validates against the root-owned allowlist before touching anything. A plain
# `sudo` child cannot do this: it would inherit agent-svc.service's own mount
# namespace, whose InaccessiblePaths= already hides /srv/stack/env (see
# ops/agent-svc.service and ops/agent-ops-apply.service) — hence a dedicated unit,
# started fresh by PID 1, instead of one more `sudo -u ... python3` rule like the
# ones above. `systemctl start` on a oneshot unit is the whole grant; there is no
# stop/restart/enable/disable rule here and none should ever be added — the
# `rollback` subcommand is operator-only and deliberately NOT reachable via sudo.
agent-svc ALL=(root) NOPASSWD: /usr/bin/systemctl start agent-ops-apply.service
