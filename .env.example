# Local development. Production values live ONLY in /srv/stack/env/task-manager.env
# on the server (chmod 600) — never in this repo, never in a chat message.

ENVIRONMENT=development
DEBUG=true
TIMEZONE=Asia/Tashkent
DEFAULT_LANGUAGE=uz

# --- Database ---
# Two drivers on purpose: asyncpg for the app, psycopg for Alembic.
DATABASE_URL=postgresql+asyncpg://taskmgr:taskmgr@postgres:5432/taskmgr
DATABASE_URL_SYNC=postgresql+psycopg://taskmgr:taskmgr@postgres:5432/taskmgr

# --- Redis ---
# Local compose runs its own Redis, so db 0 is free here. On the server the Redis
# is SHARED: db 0 is kans-shop and db 1 is qurbot, so production must use
# redis://redis:6379/2 or this stack will stomp on kans-shop's FSM state.
REDIS_URL=redis://redis:6379/0

# --- Telegram ---
# Get these from BotFather. Leave PUBLIC_URL empty locally: an empty value skips
# webhook registration, so the bot container starts without a public HTTPS URL.
BOT_TOKEN=
BOT_USERNAME=
WEBHOOK_SECRET=change-me
PUBLIC_URL=

# --- Auth ---
JWT_SECRET=dev-only-change-me-0000000000000000
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
# Shared secret the bot presents to the API; the bot is a client, not a user.
SERVICE_TOKEN=dev-only-change-me-0000000000000000
# Telegram ids approved on first login instead of waiting in the pending queue.
# Without at least one, nobody can ever approve anybody.
ADMIN_TELEGRAM_IDS=

# --- Internal ---
API_BASE_URL=http://task-api:8000

# --- Agent integration (leave empty until private runner and GitHub credentials exist) ---
GITHUB_AGENT_TOKEN=
GITHUB_PUBLIC_AGENT_TOKEN=
GITHUB_AGENT_ALLOWED_REPOS=Asadtop4ik/task-manager
AGENT_CALLBACK_TOKEN=
# Keep intake off until the separate read-only host worker is installed and
# INTAKE_WORKER_TOKEN has been provisioned in the server env (32+ characters).
AGENT_INTAKE_ENABLED=false
INTAKE_WORKER_TOKEN=
AGENT_PUBLIC_ENABLED=false
# Enable only after the read-only Ketoshop views, database role, host broker
# service and diagnostics socket have been provisioned.
KETOSHOP_DIAGNOSTICS_ENABLED=false

# Generate AGENT_CALLBACK_TOKEN and INTAKE_WORKER_TOKEN with `openssl rand -hex 32`.
# The API checks the intake token length when the pilot flag is enabled.
